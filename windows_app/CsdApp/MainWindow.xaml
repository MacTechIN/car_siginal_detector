<Window x:Class="CsdApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="운전 상황 모니터 — car_siginal_detector"
        Width="1480" Height="940" MinWidth="1100" MinHeight="700"
        Background="{StaticResource Bg}" FontFamily="Malgun Gothic"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" KeyDown="Window_KeyDown">
    <Border x:Name="DangerBorder" BorderThickness="0" BorderBrush="#FF2020">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="170"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0" Background="#1B1E23" Padding="12,8">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button x:Name="StartButton" Content="▶  시작" Style="{StaticResource ToolButton}"
                                Background="#1F6F43" Click="Start_Click" ToolTip="엔진 시작 (F5)"/>
                        <Button x:Name="StopButton" Content="■  정지" Style="{StaticResource ToolButton}"
                                Background="#7A2A2A" Click="Stop_Click" IsEnabled="False" ToolTip="엔진 정지 (Esc)"/>
                        <CheckBox x:Name="VoiceCheck" Content="음성 안내" IsChecked="True" Margin="12,0,16,0"/>
                        <CheckBox x:Name="RecordCheck" Content="녹화" IsChecked="True"/>
                        <CheckBox x:Name="LabelCheck" Content="음성 라벨링" IsChecked="True"
                                  ToolTip="신호등 상태를 말하면 학습 데이터로 저장 (빨간불, 좌회전, 맞아, 취소 ...)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="출발 전 점검" Style="{StaticResource ToolButton}" Click="Preflight_Click"/>
                        <Button Content="학습" Style="{StaticResource ToolButton}" Click="Train_Click"
                                ToolTip="음성 라벨로 모은 데이터로 신호등 분류기 학습 (train.bat)"/>
                        <Button Content="녹화 폴더" Style="{StaticResource ToolButton}" Click="Recordings_Click"/>
                        <TextBlock x:Name="StatusText" Text="정지됨" Foreground="{StaticResource Dim}"
                                   VerticalAlignment="Center" FontSize="13" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Voice caption -->
            <Border Grid.Row="1" x:Name="CaptionBar" Background="#1C1F24" Padding="22,8,22,10" MinHeight="96">
                <StackPanel>
                    <TextBlock x:Name="CaptionLabel" Text="음성 안내" FontSize="13" Foreground="#C8CCD2"/>
                    <TextBlock x:Name="CaptionText" Text="시작 버튼을 누르세요" FontSize="40" FontWeight="Bold"
                               Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Video + status panel -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="560"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="Black">
                    <Image x:Name="VideoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                    <TextBlock x:Name="VideoOverlay" Text="카메라 영상" FontSize="24" Foreground="{StaticResource Dim}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="10,8,10,0">
                    <StackPanel>
                        <!-- Traffic light -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="신호등" Style="{StaticResource CardTitle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="LampRed" Width="40" Height="40" Fill="{StaticResource Off}" Margin="0,0,10,0"/>
                                    <Ellipse x:Name="LampYellow" Width="40" Height="40" Fill="{StaticResource Off}" Margin="0,0,10,0"/>
                                    <Grid Margin="0,0,10,0">
                                        <Ellipse x:Name="LampLeft" Width="40" Height="40" Fill="{StaticResource Off}"/>
                                        <TextBlock Text="←" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Foreground="#20242A"/>
                                    </Grid>
                                    <Ellipse x:Name="LampGreen" Width="40" Height="40" Fill="{StaticResource Off}" Margin="0,0,24,0"/>
                                    <TextBlock x:Name="LightText" Text="감지 없음" FontSize="30" FontWeight="Bold"
                                               VerticalAlignment="Center" Foreground="{StaticResource Dim}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Risk -->
                        <Border x:Name="RiskCard" Style="{StaticResource CardBorder}" BorderThickness="6,0,0,0" BorderBrush="#37C869">
                            <StackPanel>
                                <TextBlock Text="위험 감지" Style="{StaticResource CardTitle}"/>
                                <DockPanel>
                                    <TextBlock x:Name="RiskLevelText" Text="안전" FontSize="32" FontWeight="Bold"
                                               Foreground="#37C869" Width="100"/>
                                    <TextBlock x:Name="TtcText" Text="충돌 위험 없음" FontSize="18" FontWeight="Bold"
                                               VerticalAlignment="Center" Width="170"/>
                                    <ProgressBar x:Name="TtcBar" Height="14" Minimum="0" Maximum="1" Value="0"
                                                 VerticalAlignment="Center" Background="{StaticResource Off}"
                                                 Foreground="#37C869" BorderThickness="0"/>
                                </DockPanel>
                                <TextBlock x:Name="RiskEventText" Text="최근 위험 이벤트 없음" FontSize="15"
                                           Foreground="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Lead vehicle -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="앞차" Style="{StaticResource CardTitle}"/>
                                <DockPanel>
                                    <TextBlock x:Name="LeadIdText" Text="앞차 없음" FontSize="26" FontWeight="Bold"
                                               Foreground="{StaticResource Dim}" Width="120"/>
                                    <TextBlock x:Name="LeadMotionText" Text="" FontSize="26" FontWeight="Bold"
                                               Foreground="#4696F5" Width="120"/>
                                    <Border x:Name="PlateBox" Background="{StaticResource Off}" CornerRadius="6" Padding="12,2">
                                        <TextBlock x:Name="PlateText" Text="번호 인식 중" FontSize="24" FontWeight="Bold"
                                                   Foreground="{StaticResource Dim}"/>
                                    </Border>
                                </DockPanel>
                                <UniformGrid Columns="4" Margin="0,10,0,0">
                                    <Border x:Name="ChipBrake" Background="{StaticResource Off}" CornerRadius="8" Margin="0,0,6,0" Padding="4,6">
                                        <TextBlock Text="브레이크" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="ChipLeft" Background="{StaticResource Off}" CornerRadius="8" Margin="0,0,6,0" Padding="4,6">
                                        <TextBlock Text="◀ 좌측" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="ChipHazard" Background="{StaticResource Off}" CornerRadius="8" Margin="0,0,6,0" Padding="4,6">
                                        <TextBlock Text="비상등" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="ChipRight" Background="{StaticResource Off}" CornerRadius="8" Padding="4,6">
                                        <TextBlock Text="우측 ▶" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Lane + ego -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="현재 차선 · 자차" Style="{StaticResource CardTitle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Canvas x:Name="LaneCanvas" Width="120" Height="62" Background="#30343A">
                                        <Line x:Name="LaneLeftLine" X1="20" Y1="2" X2="20" Y2="60" StrokeThickness="3" StrokeDashArray="2,1.5" Stroke="#6E6E6E"/>
                                        <Line x:Name="LaneRightLine" X1="100" Y1="2" X2="100" Y2="60" StrokeThickness="3" StrokeDashArray="2,1.5" Stroke="#6E6E6E"/>
                                        <Rectangle x:Name="EgoCar" Width="18" Height="30" RadiusX="4" RadiusY="4" Fill="#4696F5"
                                                   Canvas.Left="51" Canvas.Top="18"/>
                                    </Canvas>
                                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="LaneText" Text="차선 미검출" FontSize="24" FontWeight="Bold"
                                                   Foreground="{StaticResource Dim}"/>
                                        <TextBlock x:Name="EgoText" Text="자차 -" FontSize="17" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Analysis table -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock x:Name="SceneText" Text="분석 결과" Style="{StaticResource CardTitle}"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/><ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ID" Foreground="{StaticResource Dim}" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="객체" Foreground="{StaticResource Dim}" FontSize="13"/>
                                    <TextBlock Grid.Column="2" Text="상태" Foreground="{StaticResource Dim}" FontSize="13"/>
                                    <TextBlock Grid.Column="3" Text="번호판" Foreground="{StaticResource Dim}" FontSize="13"/>
                                </Grid>
                                <ItemsControl x:Name="ObjectList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/><ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="15"/>
                                                <TextBlock Grid.Column="1" Text="{Binding NameText}" FontSize="15"/>
                                                <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Plate}" FontSize="15"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Voice labelling -->
                        <Border x:Name="LabelCard" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="음성 라벨링 (학습 데이터)" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="LabelStatusText" Text="준비 중" FontSize="16" FontWeight="Bold"/>
                                <TextBlock x:Name="LabelHeardText" Text="들은 말: -" FontSize="15" Margin="0,4,0,0"/>
                                <TextBlock x:Name="LabelCountsText" Text="저장된 크롭: 없음" FontSize="15" Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Logs -->
            <Grid Grid.Row="3" Background="#0E0F12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="560"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" Margin="14,6,8,6">
                    <TextBlock DockPanel.Dock="Top" Text="이벤트 로그   id : [이름] : &quot;상태&quot;"
                               Foreground="{StaticResource Dim}" FontSize="13" Margin="0,0,0,4"/>
                    <ListBox x:Name="EventList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                             FontFamily="Consolas, Malgun Gothic" FontSize="14" DisplayMemberPath="Display"/>
                </DockPanel>
                <DockPanel Grid.Column="1" Margin="8,6,14,6">
                    <TextBlock DockPanel.Dock="Top" Text="엔진 로그" Foreground="{StaticResource Dim}" FontSize="13" Margin="0,0,0,4"/>
                    <TextBox x:Name="EngineLog" Background="Transparent" BorderThickness="0" Foreground="#9AA0A8"
                             FontFamily="Consolas, Malgun Gothic" FontSize="12" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
